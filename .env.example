PORT=3000

# JWT
JWT_SECRET=

# Environment settings for development
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=dev_db
MYSQL_USER=dev_user
MYSQL_PASSWORD=

# Database
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@localhost:3306/${MYSQL_DATABASE}?schema=public"

# S3-compatible storage
# Local dev: MinIO from docker-compose (S3_ENDPOINT=http://localhost:9000)
# Production: e.g. Cloudflare R2 — endpoint like https://<accountid>.r2.cloudflarestorage.com
# Note: no bucket name in the endpoint — the SDK appends the bucket itself (forcePathStyle)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=file-upload
S3_ENDPOINT=http://localhost:9000

# Test Database (npm test)
MYSQL_TEST_ROOT_PASSWORD=
MYSQL_TEST_DATABASE=test_db
MYSQL_TEST_USER=test_user
MYSQL_TEST_PASSWORD=
